<globals>
    <api>
        <!-- Add <enumdefs> here when a later page needs a generated API. -->
    </api>

    <consts>
        <int name="screen_width" value="240" help="F411 display width" />
        <int name="screen_height" value="280" help="F411 display height" />
        <int name="safe_side" value="16" help="Horizontal safe inset" />
        <int name="content_width" value="208" help="Width inside the safe inset" />
        <int name="row_height" value="40" help="Launcher and settings row height" />
        <int name="row_gap" value="4" help="Gap between rows" />
        <int name="radius_sm" value="6" help="Small card radius" />

        <color name="bg_base" value="0x101820" help="Default dark background" />
        <color name="surface_card" value="0x1B2935" help="Card surface" />
        <color name="surface_selected" value="0x24546B" help="Selected card surface" />
        <color name="accent" value="0x64D2FF" help="Primary accent" />
        <color name="text_primary" value="0xF4F7FA" help="Primary text" />
        <color name="text_muted" value="0xB8C7D9" help="Secondary text" />
        <color name="border" value="0x385163" help="Card border" />
        <color name="degraded" value="0xFFB454" help="Degraded status" />
    </consts>

    <styles>
        <style name="screen_base" bg_opa="100%" bg_color="#bg_base" text_color="#text_primary" />
        <style name="surface_base" bg_opa="100%" bg_color="#surface_card"
               border_width="1" border_color="#border" radius="#radius_sm" pad_all="0" />
        <style name="surface_selected_style" bg_opa="100%" bg_color="#surface_selected"
               border_width="2" border_color="#accent" radius="#radius_sm" pad_all="0" />
        <style name="text_primary_style" text_color="#text_primary" />
        <style name="text_muted_style" text_color="#text_muted" />
        <style name="text_accent" text_color="#accent" />
    </styles>

    <subjects>
        <!-- Core snapshots are not Editor subjects in M7. -->
    </subjects>

    <images>
        <!-- No external assets are part of the M7 smoke screen. -->
    </images>

    <fonts>
        <!-- Keep only the sizes used by the watchface. The source TTF is
             editor input; the export produces embedded LVGL C data. -->
        <bin name="montserrat_8" src_path="fonts/Montserrat-Medium.ttf"
             size="8" bpp="2" as_file="false" range="0x20-0x7f" />
        <bin name="montserrat_24" src_path="fonts/Montserrat-Medium.ttf"
             size="24" bpp="2" as_file="false" range="0x20-0x7f" />
        <bin name="montserrat_40" src_path="fonts/Montserrat-Medium.ttf"
             size="40" bpp="2" as_file="false" range="0x20-0x7f" />
    </fonts>
</globals>
