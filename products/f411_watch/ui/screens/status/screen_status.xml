<!-- 240x280 status shell maintained in LVGL Pro Editor. -->
<screen>
    <styles><style name="style_status" bg_opa="100%" bg_color="#bg_base" /><style name="style_rule" bg_opa="100%" bg_color="#accent" radius="1" /></styles>
    <view>
        <style name="style_status" />
        <lv_label name="page_brand" text="MAGIC WATCH" x="16" y="8" width="#content_width" height="18" style_text_color="#text_primary" style_text_align="center" ignore_layout="true" />
        <lv_label name="page_title" text="STATUS" x="16" y="28" width="#content_width" height="18" style_text_color="#accent" style_text_align="center" ignore_layout="true" />
        <lv_obj name="status_rule" x="16" y="56" width="208" height="2" scrollable="false" ignore_layout="true"><style name="style_rule" /></lv_obj>
        <lv_label name="status_time" text="TIME  --:--:--" x="16" y="72" width="208" height="18" style_text_color="#text_primary" ignore_layout="true" />
        <lv_label name="status_battery" text="BATTERY  --" x="16" y="98" width="208" height="18" style_text_color="#text_primary" ignore_layout="true" />
        <lv_label name="status_sensors" text="SENSORS  UNAVAILABLE" x="16" y="124" width="208" height="18" style_text_color="#degraded" ignore_layout="true" />
        <lv_label name="status_storage" text="STORAGE  UNKNOWN" x="16" y="150" width="208" height="18" style_text_color="#text_muted" ignore_layout="true" />
        <lv_label name="status_input" text="INPUT  CST816 / ENCODER" x="16" y="176" width="208" height="18" style_text_color="#text_muted" ignore_layout="true" />
        <lv_label name="status_reason" text="SENSOR STATUS: PENDING" x="16" y="202" width="208" height="18" style_text_color="#degraded" ignore_layout="true" />
        <lv_label name="page_hint" text="BACK: RETURN" x="16" y="262" width="#content_width" height="8" style_text_color="#text_muted" style_text_font="montserrat_8" style_text_align="center" ignore_layout="true" />
    </view>
</screen>
