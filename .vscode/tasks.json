{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "F411: Configure (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/stm32/f411_watch"
            },
            "problemMatcher": []
        },
        {
            "label": "F411: Build (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/stm32/f411_watch"
            },
            "dependsOrder": "sequence",
            "dependsOn": "F411: Configure (Debug)",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "F411: Static Analysis (cppcheck)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "--target",
                "cppcheck"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/stm32/f411_watch"
            },
            "dependsOrder": "sequence",
            "dependsOn": "F411: Configure (Debug)",
            "problemMatcher": []
        },
        {
            "label": "F411: Format",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "--target",
                "format"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/stm32/f411_watch"
            },
            "dependsOrder": "sequence",
            "dependsOn": "F411: Configure (Debug)",
            "problemMatcher": []
        },
        {
            "label": "F411: Format Check (clang-format)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "--target",
                "format-check"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/stm32/f411_watch"
            },
            "dependsOrder": "sequence",
            "dependsOn": "F411: Configure (Debug)",
            "problemMatcher": []
        },
        {
            "label": "F411: Validate",
            "dependsOrder": "sequence",
            "dependsOn": [
                "F411: Build (Debug)",
                "F411: Format Check (clang-format)",
                "F411: Static Analysis (cppcheck)"
            ],
            "problemMatcher": []
        },
        {
            "label": "F411: Pack Signed App (host)",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}/tools/manifest/manifest.py",
                "pack",
                "--image",
                "build/Debug/my_watch_f411.bin",
                "--private-key",
                "${input:f411SigningKey}",
                "--firmware-version",
                "${input:f411FirmwareVersion}",
                "--security-counter",
                "${input:f411SecurityCounter}",
                "--output",
                "build/Debug/f411-app-package.bin"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/stm32/f411_watch"
            },
            "dependsOrder": "sequence",
            "dependsOn": "F411: Build (Debug)",
            "problemMatcher": []
        },
        {
            "label": "F411: Flash (OpenOCD/ST-Link)",
            "type": "process",
            "command": "${env:APPDATA}/xPacks/@xpack-dev-tools/openocd/0.12.0-7.1/.content/bin/openocd.exe",
            "args": [
                "-s",
                "${env:APPDATA}/xPacks/@xpack-dev-tools/openocd/0.12.0-7.1/.content/openocd/scripts",
                "-f",
                "interface/stlink.cfg",
                "-c",
                "transport select swd",
                "-f",
                "target/stm32f4x.cfg",
                "-c",
                "adapter speed 1000",
                "-c",
                "init",
                "-c",
                "reset halt",
                "-c",
                "program build/Debug/f411-app-package.bin 0x08010000 verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/stm32/f411_watch"
            },
            "dependsOrder": "sequence",
            "dependsOn": "F411: Pack Signed App (host)",
            "problemMatcher": []
        },
        {
            "label": "F411: Flash Bootloader + App (OpenOCD/ST-Link)",
            "type": "process",
            "command": "${env:APPDATA}/xPacks/@xpack-dev-tools/openocd/0.12.0-7.1/.content/bin/openocd.exe",
            "args": [
                "-s",
                "${env:APPDATA}/xPacks/@xpack-dev-tools/openocd/0.12.0-7.1/.content/openocd/scripts",
                "-f",
                "interface/stlink.cfg",
                "-c",
                "transport select swd",
                "-f",
                "target/stm32f4x.cfg",
                "-c",
                "adapter speed 1000",
                "-c",
                "init",
                "-c",
                "reset halt",
                "-c",
                "program build/Debug/f411_bootloader.elf verify",
                "-c",
                "reset halt",
                "-c",
                "program build/Debug/f411-app-package.bin 0x08010000 verify",
                "-c",
                "reset run",
                "-c",
                "shutdown"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/stm32/f411_watch"
            },
            "dependsOrder": "sequence",
            "dependsOn": "F411: Pack Signed App (host)",
            "problemMatcher": []
        },
        {
            "label": "ESP32-S3: Build",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/tools/run-idf.ps1",
                "-Action",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/espressif/esp32s3_board"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "ESP32-S3: Flash (UART)",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/tools/run-idf.ps1",
                "-Action",
                "flash",
                "-Port",
                "${input:espPort}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/espressif/esp32s3_board"
            },
            "dependsOrder": "sequence",
            "dependsOn": "ESP32-S3: Build",
            "problemMatcher": []
        },
        {
            "label": "ESP32-S3: Monitor (UART)",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/tools/run-idf.ps1",
                "-Action",
                "monitor",
                "-Port",
                "${input:espPort}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/espressif/esp32s3_board"
            },
            "problemMatcher": []
        },
        {
            "label": "ESP32-S3: Flash + Monitor (UART)",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/tools/run-idf.ps1",
                "-Action",
                "flash-monitor",
                "-Port",
                "${input:espPort}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/espressif/esp32s3_board"
            },
            "dependsOrder": "sequence",
            "dependsOn": "ESP32-S3: Build",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "espPort",
            "type": "promptString",
            "description": "ESP32-S3 serial port",
            "default": "COM5"
        },
        {
            "id": "f411SigningKey",
            "type": "promptString",
            "description": "External F411 ECDSA private key path matching the Bootloader public key",
            "password": true
        },
        {
            "id": "f411FirmwareVersion",
            "type": "promptString",
            "description": "F411 firmware version",
            "default": "1"
        },
        {
            "id": "f411SecurityCounter",
            "type": "promptString",
            "description": "F411 security counter",
            "default": "1"
        }
    ]
}
